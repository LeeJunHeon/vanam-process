NEXTAUTH_URL=https://vanam.synology.me
NEXTAUTH_SECRET=          # 다른 앱과 동일한 값 (다르면 SSO 깨짐)
GOOGLE_CLIENT_ID=         # 다른 앱과 동일
GOOGLE_CLIENT_SECRET=     # 다른 앱과 동일
DATABASE_URL=postgresql://inv_user:PASSWORD@inventory-web-postgres:5432/DBNAME
UPLOAD_DIR=/app/uploads
NEXT_PUBLIC_BASE_PATH=/process
GOOGLE_CALENDAR_SUBJECT=       # 캘린더 소유 계정 (도메인 위임 대행 대상)
GOOGLE_CALENDAR_KEY_FILE=/app/secrets/service-account-key.json
