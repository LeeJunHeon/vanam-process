generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["process", "hr", "public"]
}

// ───────────────────────────────────────────────
// 인증용 매핑 (이 앱이 만들지 않음, 읽기만)
// ───────────────────────────────────────────────

// public.user — SSO 공유 사용자
model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String? @unique
  role     String?
  isActive String  @default("Y") @map("is_active")

  @@map("user")
  @@schema("public")
}

// hr.employees — 권한 판정(직급)용
model Employee {
  id         Int       @id @default(autoincrement())
  userId     Int?      @unique @map("user_id")
  name       String    @db.VarChar(100)
  email      String?   @db.VarChar(255)
  isActive   Boolean   @default(true) @map("is_active")
  position   Position? @relation(fields: [positionId], references: [id])
  positionId Int?      @map("position_id")

  workProcesses WorkOrderProcess[]
  processOwner  ProcessOwner?

  @@map("employees")
  @@schema("hr")
}

// hr.positions — CEO / ADMIN / EMPLOYEE
model Position {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(50)
  name      String     @db.VarChar(100)
  employees Employee[]

  @@map("positions")
  @@schema("hr")
}

// ───────────────────────────────────────────────
// process 스키마 — 이 앱이 소유
// ───────────────────────────────────────────────

// 기판 반입 기록 1건
model SubstrateReceipt {
  id             Int       @id @default(autoincrement())
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  manager        String    @db.VarChar(50)
  source         String?   @db.VarChar(100)
  clientName     String?   @map("client_name") @db.VarChar(100)
  memo           String?
  createdByEmail String    @map("created_by_email") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 소프트 삭제 — 증거 보존을 위해 실제로 지우지 않는다
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByEmail String?   @map("deleted_by_email") @db.VarChar(255)

  // 발주 공정 연결 (선택). 공정이 DB에서 정리돼도 기판 기록은 남아야 하므로 SetNull.
  orderProcessId Int?              @map("order_process_id")
  orderProcess   WorkOrderProcess? @relation(fields: [orderProcessId], references: [id], onDelete: SetNull)

  photos SubstratePhoto[]

  @@index([receivedAt])
  @@index([deletedAt])
  @@index([orderProcessId])
  @@map("substrate_receipt")
  @@schema("process")
}

// 기판 사진 (건당 1장 이상 필수)
model SubstratePhoto {
  id             Int       @id @default(autoincrement())
  receiptId      Int       @map("receipt_id")
  originalName   String    @map("original_name") @db.VarChar(255)
  storedPath     String    @map("stored_path") @db.VarChar(500)
  fileSize       Int?      @map("file_size")
  mimeType       String?   @map("mime_type") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // 소프트 삭제 — 사진 파일은 디스크에서 절대 지우지 않는다
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByEmail String?   @map("deleted_by_email") @db.VarChar(255)

  receipt SubstrateReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("substrate_photo")
  @@schema("process")
}

// 활동 이력 — 등록/수정/삭제 전부 기록
// ★ 기판 기록이 삭제돼도 이력은 남아야 하므로 FK를 걸지 않는다 (의도적)
model ActivityLog {
  id         Int      @id @default(autoincrement())
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   Int      @map("target_id")
  action     String   @db.VarChar(20)
  actorEmail String   @map("actor_email") @db.VarChar(255)
  actorName  String?  @map("actor_name") @db.VarChar(100)
  summary    String?
  // 그 시점의 기록 전체 값. 이력에서 과거 상태를 그대로 재현하기 위함.
  snapshot   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("activity_log")
  @@schema("process")
}

// ───────────────────────────────────────────────
// 발주공정 관리 (구글시트 이관)
// ───────────────────────────────────────────────

// 공정 담당자 화이트리스트 — 시트 '코드' E열(담당자 8명) 대응.
// hr.employees 전체가 아니라 이 테이블에 등록된 인원만 담당자 드롭다운에 노출한다.
model ProcessOwner {
  id         Int      @id @default(autoincrement())
  employeeId Int      @unique @map("employee_id")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("process_owner")
  @@schema("process")
}

// 공정 코드 마스터 — 시트 '코드' A열 + '캘린더 ID' 시트 통합
model ProcessCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  calendarId      String?  @map("calendar_id") @db.VarChar(255)
  calendarEnabled Boolean  @default(false) @map("calendar_enabled")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  processes WorkOrderProcess[]

  @@map("process_code")
  @@schema("process")
}

// 발주마스터 — 발주번호당 1행
model WorkOrder {
  id               Int       @id @default(autoincrement())
  orderNo          String    @unique @map("order_no") @db.VarChar(20)
  kind             String    @default("발주") @db.VarChar(20) // 발주 | 사내작업
  receivedAt       DateTime  @map("received_at") @db.Date
  company          String?   @db.VarChar(100)
  customerName     String?   @map("customer_name") @db.VarChar(100)
  jobName          String?   @map("job_name") @db.VarChar(200)
  sampleReceivedAt DateTime? @map("sample_received_at") @db.Date
  dueAt            DateTime? @map("due_at") @db.Date
  paymentStatus    String    @default("미결제") @map("payment_status") @db.VarChar(30)
  precheckStatus   String    @default("미완료") @map("precheck_status") @db.VarChar(30)
  memo             String?
  createdByEmail   String    @map("created_by_email") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByEmail   String?   @map("deleted_by_email") @db.VarChar(255)

  processes WorkOrderProcess[]

  @@index([receivedAt])
  @@index([deletedAt])
  @@map("work_order")
  @@schema("process")
}

// 공정내역 — 발주 내 시퀀스 단위. calendar_* 컬럼은 Phase 2 연동용 예약.
model WorkOrderProcess {
  id              Int       @id @default(autoincrement())
  orderId         Int       @map("order_id")
  sequence        Int
  processCodeId   Int       @map("process_code_id")
  detail          String?   @db.VarChar(200)
  qty             Int?
  plannedStart    DateTime? @map("planned_start") @db.Date
  durationHours   Float?    @map("duration_hours")
  status          String    @default("대기") @db.VarChar(20)
  location        String?   @db.VarChar(100)
  ownerEmployeeId Int?      @map("owner_employee_id")
  memo            String?
  calendarId      String?   @map("calendar_id") @db.VarChar(255)
  calendarEventId String?   @map("calendar_event_id") @db.VarChar(255)
  syncStatus      String?   @map("sync_status") @db.VarChar(30)
  syncedAt        DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByEmail  String?   @map("deleted_by_email") @db.VarChar(255)

  order       WorkOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processCode ProcessCode @relation(fields: [processCodeId], references: [id])
  owner       Employee?   @relation(fields: [ownerEmployeeId], references: [id])

  substrateReceipts SubstrateReceipt[]

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([plannedStart])
  @@index([deletedAt])
  @@map("work_order_process")
  @@schema("process")
}

// ───────────────────────────────────────────────
// 장비 운전 모니터링 (erp-agent / 장비 리포터가 수집)
// ───────────────────────────────────────────────

model OpsState {
  equipment String   @id
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ops_state")
  @@schema("process")
}

model OpsRun {
  id          Int        @id @default(autoincrement())
  msgId       String?    @unique @map("msg_id")
  equipment   String
  status      String
  processName String?    @map("process_name")
  params      Json?
  startedAt   DateTime   @map("started_at")
  endedAt     DateTime?  @map("ended_at")
  errorMsg    String?    @map("error_msg")
  events      OpsEvent[]

  @@index([equipment, startedAt])
  @@map("ops_run")
  @@schema("process")
}

model OpsEvent {
  id        Int      @id @default(autoincrement())
  msgId     String?  @unique @map("msg_id")
  equipment String
  runId     Int?     @map("run_id")
  run       OpsRun?  @relation(fields: [runId], references: [id])
  ts        DateTime
  level     String
  message   String

  @@index([equipment, ts])
  @@map("ops_event")
  @@schema("process")
}

model OpsCommand {
  id          Int       @id @default(autoincrement())
  equipment   String
  command     String
  args        Json?
  status      String    @default("pending")
  label       String?
  requestedBy String    @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  expiresAt   DateTime  @map("expires_at")
  sentAt      DateTime? @map("sent_at")
  finishedAt  DateTime? @map("finished_at")
  result      String?

  @@index([equipment, requestedAt])
  @@index([equipment, status])
  @@map("ops_command")
  @@schema("process")
}

model OpsNotice {
  id        Int       @id @default(autoincrement())
  msgId     String?   @unique @map("msg_id")
  equipment String
  ts        DateTime
  level     String
  title     String
  message   String
  origin    String?
  source    String?
  ackedBy   String?   @map("acked_by")
  ackedAt   DateTime? @map("acked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([equipment, ackedAt])
  @@map("ops_notice")
  @@schema("process")
}

model OpsRecipe {
  id        Int      @id @default(autoincrement())
  equipment String
  kind      String
  name      String
  rows      Json
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String   @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@unique([equipment, kind, name])
  @@index([equipment, kind, name])
  @@map("ops_recipe")
  @@schema("process")
}

// ───────────────────────────────────────────────
// 챔버K v2 장비 연결(ops2) — 계약은 챔버K v2 common/messages.py.
// v1(ops_*)과 따로 둔다. 표는 prisma/sql/ops2.sql 로 만든다(마이그레이션 없음). 관계(FK) 없음.
// ts = 장비 시계, receivedAt = 웹이 받은 시각.
// ───────────────────────────────────────────────

// 장비 등록·연결 상태. 토큰은 sha256 해시만(없으면 연결 거부). 토큰은 장비 ID 에 묶인다.
// holder = 지금 받아 주는 실행(lease — 30 s 넘게 조용하면 다른 실행이 넘겨받는다), conflict = 마지막 409
model Ops2Device {
  equipment        String    @id
  label            String?
  enabled          Boolean   @default(true)
  tokenHash        String?   @map("token_hash")
  holderInstance   String?   @map("holder_instance")
  holderSeenAt     DateTime? @map("holder_seen_at") @db.Timestamptz(6)
  conflictInstance String?   @map("conflict_instance")
  conflictAt       DateTime? @map("conflict_at") @db.Timestamptz(6)
  runMode          String?   @map("run_mode")
  writesAllowed    Boolean?  @map("writes_allowed")
  program          String?
  version          String?
  schemaHash       String?   @map("schema_hash")
  webSchemaHash    String?   @map("web_schema_hash")
  configVersion    Int?      @map("config_version")
  clockSkewMs      Int?      @map("clock_skew_ms") // 장비 시계 − 웹 시계
  lastHello        Json?     @map("last_hello") // webSchema 뺀 hello
  lastHelloAt      DateTime? @map("last_hello_at") @db.Timestamptz(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ops2_device")
  @@schema("process")
}

// 실행(프로그램을 켤 때마다 새 instance)
model Ops2Instance {
  instance        String    @id
  equipment       String
  program         String?
  version         String?
  runMode         String?   @map("run_mode")
  schemaHash      String?   @map("schema_hash")
  webSchemaHash   String?   @map("web_schema_hash")
  configVersion   Int?      @map("config_version")
  snapshotColumns Json?     @map("snapshot_columns")
  commandKinds    Json?     @map("command_kinds")
  writesAllowed   Boolean?  @map("writes_allowed")
  helloAt         DateTime? @map("hello_at") @db.Timestamptz(6)
  firstSeenAt     DateTime  @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @map("last_seen_at") @db.Timestamptz(6)

  @@index([equipment, firstSeenAt])
  @@map("ops2_instance")
  @@schema("process")
}

// 최신 state 하나(POST 마다 배치의 마지막 것)
model Ops2State {
  equipment  String   @id
  instance   String
  msgId      String   @map("msg_id")
  seq        Int
  ts         DateTime @db.Timestamptz(6)
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)
  procState  String?  @map("proc_state")
  runId      String?  @map("run_id")
  data       Json

  @@map("ops2_state")
  @@schema("process")
}

// 웹 설정 내보내기 묶음(web_schema.bundle) — 해시별 한 번
model Ops2WebSchema {
  hash            String   @id
  version         Int?
  paramSchemaHash String?  @map("param_schema_hash")
  bundle          Json
  firstEquipment  String   @map("first_equipment")
  receivedAt      DateTime @map("received_at") @db.Timestamptz(6)

  @@map("ops2_web_schema")
  @@schema("process")
}

// 공정(행 단위) — run_start·run_end 가 어느 순서로 와도 한 행
model Ops2Run {
  runId         String    @id @map("run_id")
  equipment     String
  instance      String
  startMsgId    String?   @unique @map("start_msg_id")
  endMsgId      String?   @unique @map("end_msg_id")
  recipeName    String?   @map("recipe_name")
  startedBy     String?   @map("started_by")
  name          String?
  stepNo        Int?      @map("step_no")
  params        Json?
  blocks        Json?
  configVersion Int?      @map("config_version")
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  result        String?
  reasonCode    String?   @map("reason_code")
  summary       Json?

  @@index([equipment, startedAt])
  @@map("ops2_run")
  @@schema("process")
}

// 사건(event). 웹이 만든 것(INSTANCE_TAKEOVER 등)은 source "web", seq 0
model Ops2Event {
  msgId      String    @id @map("msg_id")
  equipment  String
  instance   String
  seq        Int
  runId      String?   @map("run_id")
  ts         DateTime  @db.Timestamptz(6)
  receivedAt DateTime  @map("received_at") @db.Timestamptz(6)
  level      String
  code       String
  ruleId     String?   @map("rule_id")
  message    String
  source     String?
  kind       String?
  context    Json?
  ackedBy    String?   @map("acked_by")
  ackedAt    DateTime? @map("acked_at") @db.Timestamptz(6)

  @@index([equipment, ts])
  @@index([runId])
  @@index([equipment, level, ackedAt])
  @@map("ops2_event")
  @@schema("process")
}

// 1분 요약 — 공정 중인 것만(run_id 가 붙는 것). 프로그램을 다시 켠 분에는 같은 구간이 둘일 수 있다(UNIQUE 없음)
model Ops2Summary {
  msgId     String   @id @map("msg_id")
  equipment String
  instance  String
  runId     String   @map("run_id")
  fromTs    DateTime @map("from_ts") @db.Timestamptz(6)
  toTs      DateTime @map("to_ts") @db.Timestamptz(6)
  rowCount  Int      @map("row_count")
  stats     Json
  quality   Json

  @@index([equipment, fromTs])
  @@index([runId])
  @@map("ops2_summary")
  @@schema("process")
}

// 명령. origin web = 웹이 만든 것(W-2), hmi = 노트북에서 실행된 것(cmd_result 로 알게 됨)
// status: pending → sent → accepted / rejected, 또는 expired
model Ops2Command {
  id              String    @id
  equipment       String
  targetInstance  String?   @map("target_instance")
  origin          String
  kind            String
  args            Json      @default("{}")
  label           String?
  requestedBy     String    @map("requested_by")
  requestedAt     DateTime  @map("requested_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6) // 장비 시계 기준
  expiresAtServer DateTime? @map("expires_at_server") @db.Timestamptz(6)
  status          String
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6) // 처음 보낸 시각
  lastSentAt      DateTime? @map("last_sent_at") @db.Timestamptz(6)
  sendCount       Int       @default(0) @map("send_count")
  sentVia         String?   @map("sent_via")
  resultAt        DateTime? @map("result_at") @db.Timestamptz(6)
  reasonCode      String?   @map("reason_code")
  detail          String?
  resultMsgId     String?   @unique @map("result_msg_id")
  resultInstance  String?   @map("result_instance")

  @@index([equipment, status])
  @@index([equipment, requestedAt])
  @@map("ops2_command")
  @@schema("process")
}

// 설정 버전(웹이 값의 원본). kind: import(장비 현재값) / apply / rollback — 보내기는 W-5
model Ops2ConfigVersion {
  equipment       String
  version         Int
  kind            String
  paramValues     Json      @map("param_values")
  paramSchemaHash String?   @map("param_schema_hash")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  note            String?
  cmdId           String?   @map("cmd_id")
  ackStatus       String?   @map("ack_status")
  ackAt           DateTime? @map("ack_at") @db.Timestamptz(6)
  reasonCode      String?   @map("reason_code")
  errors          Json?
  appliedKeys     Json?     @map("applied_keys")
  pendingKeys     Json?     @map("pending_keys")
  overriddenKeys  Json?     @map("overridden_keys")
  changes         Json?
  ackMsgId        String?   @unique @map("ack_msg_id")

  @@id([equipment, version])
  @@map("ops2_config_version")
  @@schema("process")
}

// 받지 못한 envelope — 넣고 ack 한다(안 하면 장비가 계속 다시 보냄). raw 는 64 KB 까지
model Ops2BadMessage {
  id         String   @id
  equipment  String
  instance   String?
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)
  reason     String
  raw        String?

  @@map("ops2_bad_message")
  @@schema("process")
}

// 장비 담당자 — equipment 는 기준 장비 ID(-SIM 을 뗀 것, 예 CHK2). employee_id = hr.employees.id(FK 없음)
model Ops2Operator {
  equipment  String
  employeeId Int      @map("employee_id")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([equipment, employeeId])
  @@index([employeeId])
  @@map("ops2_operator")
  @@schema("process")
}
